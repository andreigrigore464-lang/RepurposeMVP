# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repurpose_db?schema=public"

# Google Gemini AI API
GEMINI_API_KEY="your_gemini_api_key_here"

# Cloudinary (Media Asset Management & Public Slide Hosting)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Templated.io (Automated Slide & Social Card Image Generation)
TEMPLATED_API_KEY="your_templated_api_key_here"

# Unsplash API (Fallback Stock Photos)
UNSPLASH_ACCESS_KEY="your_unsplash_access_key_here"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
